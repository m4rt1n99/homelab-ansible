---
# API keys
slskd_api_key: "CHANGE_ME"
prowlarr_api_key: "CHANGE_ME"
radarr_api_key: "CHANGE_ME"
sonarr_api_key: "CHANGE_ME"

# Login Credentials
smb_password: "CHANGE_ME"
soulseek_username: "CHANGE_ME"
soulseek_password: "CHANGE_ME"
slskd_username: "CHANGE_ME"
slskd_password: "CHANGE_ME"
navidrome_username: "admin" # Should be "admin" for the default admin user
navidrome_password: "CHANGE_ME"
navidrome_salt: "CHANGE_ME"
jellyfin_username: "admin"
jellyfin_password: "CHANGE_ME"
qbittorrent_username: "admin"
qbittorrent_password: "CHANGE_ME"
immich_admin_email: "CHANGE_ME"
immich_admin_password: "CHANGE_ME"
immich_admin_name: "Admin"
# Internal Postgres password for the immich database (container-to-container only).
immich_postgres_password: "CHANGE_ME"

# Beszel monitoring agent: both values come from the hub's "Add System" dialog.
# KEY is the hub's SSH public key, TOKEN is the per-agent registration token.
beszel_key: "CHANGE_ME"
beszel_token: "CHANGE_ME"

# Replace this with the actual UUID of the NVMe drive you want to use for the ZFS pool. You can find it using `lsblk -o NAME,UUID` on the target host.
nvme_uuid: "CHANGE_ME"

# Replace these with the actual PARTUUIDs of the disks you want to use for the ZFS pool. You can find them using `lsblk -o NAME,PARTUUID` on the target host.
zfs_disk1_partuuid: "CHANGE_ME"
zfs_disk2_partuuid: "CHANGE_ME"

# linuxserver.io container user (user 'abc' inside the containers).
# All arr/download containers share /mnt/nvme/media/video for hardlinks, so they
# must run as the same uid/gid and that uid/gid must own the media tree on the host.
media_puid: 1000
media_pgid: 1000

# Services
base_url: "http://CHANGE_ME"

# service_ports.<name> is the PUBLIC (host) port a service is published on.
# Container-to-container traffic uses the container name + the app's internal
# port, not these values, so the two only differ when the host port is taken
# (see qbittorrent below).
service_ports:
  homepage: 3000
  musicgrabber: 8080
  slskd: 5030
  navidrome: 4533
  jellyfin: 8096
  # qbittorrent runs inside gluetun's network namespace: it listens on 8080
  # internally, and gluetun publishes it on the host as qbittorrent_published
  # (8080 is already taken on the host by musicgrabber).
  qbittorrent: 8080
  qbittorrent_published: 8081
  prowlarr: 9696
  flaresolverr: 8191
  radarr: 7878
  sonarr: 8989
  bazarr: 6767
  immich: 2283


# Prowlarr indexers to provision.
prowlarr_min_seeders: 10

prowlarr_indexers:
  - name: "YTS"
  - name: "The Pirate Bay"
  - name: "1337x"
    flaresolverr: true
  - name: "LimeTorrents"
    flaresolverr: true
  - name: "Magnet Cat"
    flaresolverr: true
  - name: "EZTV"
    flaresolverr: true

# VPN configuration
vpn_wireguard_private_key: "CHANGE_ME"
vpn_wireguard_addresses: "CHANGE_ME"
vpn_server_countries:
  - "CHANGE_ME"

# HDD spindown configuration
hdd_spindown_enabled: true
hdd_spindown_devices:
  - device: "/dev/disk/by-partuuid/{{ zfs_disk1_partuuid }}"
    timeout: 3600
  - device: "/dev/disk/by-partuuid/{{ zfs_disk2_partuuid }}"
    timeout: 3600
