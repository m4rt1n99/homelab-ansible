all:
  children:
    my-group:
      hosts:
        my-host:
          ansible_host: 192.168.1.100
          ansible_user: ansible
          ansible_ssh_private_key_file: '~/.ssh/key'
          ansible_python_interpreter: /usr/bin/python3
          ansible_become_method: sudo
          host_roles:
            - common
            - zfs
            - smb
            - hdd_spindown
            - sftp
            - podman_network
            - gluetun
            - qbittorrent
            - jellyfin
            - radarr
            - sonarr
            - flaresolverr
            - prowlarr
            - seerr
            - navidrome
            - slskd
            - musicgrabber
            - soulsync
            - immich
            - homepage
