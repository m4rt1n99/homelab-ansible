all:
  children:
    my-group:
      hosts:
        my-host:
          ansible_host: 192.168.1.100
          ansible_user: ansible
          ansible_ssh_private_key_file: '~/.ssh/key'
          ansible_python_interpreter: /usr/bin/python3
          ansible_become_method: sudo
          system_shell: /bin/bash
          os_family: Debian
          host_roles:
            - common
            - smb
            - zfs
            - hdd_spindown
          hostname: my-host
