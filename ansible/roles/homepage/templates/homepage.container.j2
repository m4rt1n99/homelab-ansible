[Unit]
Description=Homepage - Personal dashboard

[Container]
# Image
Image=ghcr.io/gethomepage/homepage:latest
ContainerName=homepage

# Networking
Network=vps-services.network
PublishPort={{ service_ports.homepage }}:3000

# Environment
Environment=HOMEPAGE_ALLOWED_HOSTS=*

# Storage
Volume=/mnt/nvme/services/homepage/config:/app/config
# Read-only mounts so the resources info widgets can report disk usage via `df`.
# df stats are per-filesystem, so binding an (empty) dir on the root FS reports
# root-disk usage without exposing the whole host tree to the container.
Volume=/srv:/mnt/host:ro
Volume=/mnt/nvme:/mnt/nvme:ro
Volume=/mnt/storage:/mnt/storage:ro

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
