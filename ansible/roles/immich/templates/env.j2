# Database (immich_postgres container, same podman network)
DB_HOSTNAME=immich_postgres
DB_PORT=5432
DB_USERNAME=immich
DB_PASSWORD={{ immich_postgres_password }}
DB_DATABASE_NAME=immich

# Redis / Valkey (immich_redis container, same podman network)
REDIS_HOSTNAME=immich_redis
REDIS_PORT=6379

# Immich server
# System settings (incl. storage template) are managed via this config file.
IMMICH_CONFIG_FILE=/config/immich-config.json
# The media library (originals, thumbs, encoded video, profile, backups) lives under
# the /data mount defined in immich.container.j2 (host /mnt/nvme/media/immich -> /data).
# UPLOAD_LOCATION / THUMB_LOCATION / etc. are docker-compose substitution variables,
# not immich-server runtime config, so they are intentionally NOT set here.