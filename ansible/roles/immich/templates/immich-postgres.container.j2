[Unit]
Description=Immich - PostgreSQL

[Container]
# Image
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
ContainerName=immich_postgres
ShmSize=128m

# Networking
Network=vps-services.network

# Environment
Environment=POSTGRES_USER=immich
Environment=POSTGRES_PASSWORD={{ immich_postgres_password }}
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS=--data-checksums

# Storage
Volume=/mnt/nvme/services/immich/postgres/data:/var/lib/postgresql/data

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
