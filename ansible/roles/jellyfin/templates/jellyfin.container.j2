[Unit]
Description=Jellyfin - Media server

[Container]
Image=docker.io/jellyfin/jellyfin:latest
ContainerName=jellyfin
Network=vps-services.network
PublishPort={{ service_ports.jellyfin }}:8096

Volume=/mnt/nvme/media/video/library:/media
Volume=/mnt/nvme/services/jellyfin/config:/config
Volume=/mnt/nvme/services/jellyfin/cache:/cache

[Install]
WantedBy=multi-user.target default.target