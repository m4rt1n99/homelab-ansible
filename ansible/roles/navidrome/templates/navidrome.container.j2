[Unit]
Description=Navidrome - Music Collection Manager

[Container]
Image=docker.io/deluan/navidrome:latest
ContainerName=navidrome
Network=vps-services.network
PublishPort={{ service_ports.navidrome }}:4533
Volume=/mnt/nvme/services/navidrome/data:/data
Volume=/mnt/nvme/media/navidrome:/music
# Auto-creates the "admin" user on first boot (empty DB), skipping the setup wizard.
Environment=ND_DEVAUTOCREATEADMINPASSWORD={{ navidrome_password }}

[Install]
WantedBy=multi-user.target default.target