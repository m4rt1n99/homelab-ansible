[Unit]
Description=qBittorrent - Torrent download client (via gluetun VPN)
BindsTo=gluetun.service
After=gluetun.service

[Container]
# Image
Image=lscr.io/linuxserver/qbittorrent:latest
ContainerName=qbittorrent

# Networking
# Route all traffic through the gluetun VPN container
Network=container:gluetun

# Environment
Environment=PUID={{ media_puid }}
Environment=PGID={{ media_pgid }}
Environment=UMASK=002
Environment=TZ=Europe/Prague
Environment=WEBUI_PORT={{ service_ports.qbittorrent }}

# Storage
Volume=/mnt/nvme/services/qbittorrent:/config
Volume=/mnt/nvme/media/video:/data

[Service]
Restart=always
# Don't start until the VPN tunnel has an address, otherwise qBittorrent binds to
# a missing tun0 and every peer/tracker fails "Operation not permitted".
ExecStartPre=/usr/bin/timeout 90 sh -c 'until /usr/bin/podman exec gluetun ip -o -4 addr show tun0 2>/dev/null | grep -q "inet "; do sleep 1; done'

[Install]
WantedBy=multi-user.target default.target
