[Unit]
Description=Seerr - Request management and media discovery
After=radarr.service sonarr.service jellyfin.service
Wants=radarr.service sonarr.service jellyfin.service

[Container]
# Image
Image=ghcr.io/seerr-team/seerr:latest
ContainerName=seerr

# Networking
Network=vps-services.network
PublishPort={{ service_ports.seerr }}:5055

# Environment
Environment=TZ=Europe/Prague
Environment=LOG_LEVEL=info
Environment=PORT=5055

# Storage
Volume=/mnt/nvme/services/seerr:/app/config

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
