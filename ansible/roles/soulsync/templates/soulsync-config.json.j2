{
  "active_media_server": "navidrome",
  "spotify": {
    "client_id": "SpotifyClientID",
    "client_secret": "SpotifyClientSecret",
    "redirect_uri": "http://127.0.0.1:8888/callback"
  },
  "tidal": {
    "client_id": "TidalClientID",
    "client_secret": "TidalClientSecret",
    "redirect_uri": "http://127.0.0.1:8889/tidal/callback"
  },
  "plex": {
    "base_url": "http://192.168.86.36:32400",
    "token": "PLEX_API_TOKEN",
    "auto_detect": true
  },
  "jellyfin": {
    "base_url": "http://localhost:8096",
    "api_key": "JELLYFIN_API_KEY",
    "auto_detect": true
  },
  "navidrome": {
    "base_url": "http://navidrome:{{ service_ports.navidrome }}",
    "username": "{{ navidrome_username }}",
    "password": "{{ navidrome_password }}",
    "auto_detect": true
  },
  "soulseek": {
    "slskd_url": "http://slskd:{{ service_ports.slskd }}",
    "api_key": "{{ slskd_api_key }}",
    "download_path": "/app/downloads",
    "transfer_path": "/app/Transfer",
    "search_timeout": 60,
    "search_timeout_buffer": 15
  },
{# Hybrid: try Soulseek first (FLAC via the audiophile profile), fall back to
   YouTube (lossy) only when Soulseek finds no lossless match. #}
  "download_source": {
    "mode": "hybrid",
    "hybrid_primary": "soulseek",
    "hybrid_secondary": "youtube",
    "hybrid_order": ["soulseek", "youtube"]
  },
{# FLAC/lossless-only for streaming sources; allow_fallback=false rejects lower quality.
   Soulseek's FLAC-only enforcement is the "audiophile" quality_profile, which lives in
   the app DB (not config.json) and is applied via the API in tasks/main.yml. #}
  "tidal_download": {
    "quality": "lossless",
    "allow_fallback": false
  },
  "qobuz": {
    "quality": "lossless",
    "allow_fallback": false
  },
  "hifi_download": {
    "quality": "lossless",
    "allow_fallback": false
  },
  "deezer_download": {
    "quality": "flac",
    "allow_fallback": false
  },
  "amazon_download": {
    "quality": "flac",
    "allow_fallback": false
  },
  "logging": {
    "path": "logs/app.log",
    "level": "INFO"
  },
  "database": {
    "path": "database/music_library.db",
    "max_workers": 5
  },
  "metadata_enhancement": {
    "enabled": true,
    "embed_album_art": true,
    "single_to_album": false
  },
  "file_organization": {
    "enabled": true,
    "_template_variables": "Available: $artist, $albumartist, $artistletter, $album, $title, $track, $disc, $year, $playlist, $quality (filename only)",
    "templates": {
      "album_path": "$albumartist/$albumartist - $album/$track - $title",
      "single_path": "$artist/$artist - $title/$title",
      "compilation_path": "Compilations/$album/$track - $artist - $title",
      "playlist_path": "$playlist/$artist - $title"
    }
  },
  "import": {
    "staging_path": "./Staging",
    "replace_lower_quality": false,
    "folder_artist_override": true
  },
  "lossy_copy": {
    "enabled": false,
    "bitrate": "320",
    "downsample_hires": false
  },
  "playlist_sync": {
    "create_backup": true
  },
  "listenbrainz": {
    "token": "LISTENBRAINZ_TOKEN"
  }
}